.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw and generated data files contain patient-identifiable information (PHI).
# Never commit these — keep them local only.
data/raw/*
!data/raw/.gitkeep
data/generated/*
!data/generated/.gitkeep
*.xlsx
*.xls
*.csv
!data/sample_synthetic/*.csv
# The bundled Test Master List has no patient data - safe to commit and ship with the app.
!reference_data/*.xlsx
# De-identified daily exports for the report workflow. A pre-commit / CI guard
# (scripts/check_no_phi.py) blocks any file here that still contains PHI.
!data/incoming/*.xlsx

output/
reports_out/
*.pdf

.streamlit/secrets.toml
