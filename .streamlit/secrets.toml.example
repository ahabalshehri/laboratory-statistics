# Copy to .streamlit/secrets.toml (git-ignored) for local testing, OR paste
# these keys into the "Secrets" box when deploying on Streamlit Community Cloud.

# Setting app_password turns on the login gate AND the "hosted" safety mode
# (server-side de-identification is forced, the raw upload is discarded).
# Leave it unset for a local run to keep the app open with no prompt.
app_password = "change-me"
